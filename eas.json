{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "android": {
      "env": {
        "YARN_VERSION": "4.12.0"
      }
    },
    "ios": {
      "env": {
        "YARN_VERSION": "4.12.0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
