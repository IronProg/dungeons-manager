{
  "expo": {
    "name": "dungeons-manager",
    "slug": "dungeons-manager",
    "version": "1.0.0",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-build-properties",
      "expo-image",
      "expo-sqlite"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ironprog.dungeonsmanager",
      "jsEngine": "hermes"
    },
    "android": {
      "softwareKeyboardLayoutMode": "adjustPan",
      "package": "com.ironprog.dungeonsmanager",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "jsEngine": "hermes"
    },
    "scheme": "dungeons-manager-scheme",
    "extra": {
      "eas": {
        "projectId": "eca17c32-b071-4aca-9b2b-abff5ec3dd49"
      }
    }
  }
}
